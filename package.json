{
  "name": "skilldex",
  "displayName": "SkillDex",
  "description": "Panel para descubrir, activar y editar Rules y Skills locales bajo .cursor/ en Cursor",
  "version": "1.0.0",
  "publisher": "andoni",
  "author": {
    "name": "Andoni Gallardo"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiyameh/skilldex.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "skills",
    "rules",
    "ai",
    "dashboard",
    "skilldex"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "skilldex.openDashboard",
        "title": "Abrir SkillDex",
        "category": "SkillDex"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skilldex",
          "title": "SkillDex",
          "icon": "media/skilldex-icon.svg"
        }
      ]
    },
    "views": {
      "skilldex": [
        {
          "type": "webview",
          "id": "skilldex.dashboardView",
          "name": "SkillDex"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p tsconfig.extension.json",
    "watch:host": "tsc -p tsconfig.extension.json --watch",
    "build:webview": "vite build --config src/webview/vite.config.ts",
    "watch:webview": "vite build --config src/webview/vite.config.ts --watch",
    "build": "npm run compile && npm run build:webview",
    "watch": "concurrently -n host,webview -c blue,magenta \"npm run watch:host\" \"npm run watch:webview\"",
    "package": "mkdir -p download && vsce package --out download/skilldex-$npm_package_version.vsix",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.vitest.json && tsc --noEmit -p tsconfig.integration.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "npm run compile && tsc -p tsconfig.integration.json && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.8",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
