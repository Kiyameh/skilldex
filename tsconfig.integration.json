{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "lib": ["ES2022"],
    "types": ["node", "vscode", "mocha"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.integration.test.ts"],
  "exclude": ["node_modules", "dist", "out", "src/webview"]
}
