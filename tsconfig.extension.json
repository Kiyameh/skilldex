{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/extension/**/*.ts", "src/shared/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "src/webview",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
