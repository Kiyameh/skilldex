{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/extension",
    "outDir": "out/extension",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/extension/**/*.ts"],
  "exclude": ["node_modules", "dist", "out", "src/webview"]
}
