{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/webview/**/*.ts",
    "src/webview/**/*.tsx",
    "src/webview/**/*.d.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "src/webview/vite.config.ts",
    "src/webview/setup-tests.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
