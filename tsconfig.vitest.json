{
  "extends": "./tsconfig.webview.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "src/webview/**/*.ts",
    "src/webview/**/*.tsx",
    "src/webview/**/*.d.ts",
    "src/shared/**/*.ts",
